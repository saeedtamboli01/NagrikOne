\r\n39:         );\r\n40:       }\r\n41:       return NextResponse.json({\r\n42:         success: true,\r\n43:         message: result.message,\r\n44:         cooldownSeconds: result.cooldownSeconds,\r\n45:         expirySeconds: result.expirySeconds,\r\n46:         devOtp: result.devOtp\r\n47:       });\r\n48:     }\r\n49: \r\n50:     if (action === 'verify') {\r\n51:       const code = String(body.code || '').trim();\r\n52:       const name = body.name ? String(body.name).trim() : undefined;\r\n53: \r\n54:       const result = await verifyOtp(target, code, name);\r\n55:       if (!result.success || !result.user) {\r\n56:         return NextResponse.json(\r\n57:           { error: result.message },\r\n58:           { status: 400 }\r\n59:         );\r\n60:       }\r\n61: \r\n62:       // Create session token and set secure HTTP-only cookie\r\n63:       const userAgent = req.headers.get('user-agent') || undefined;\r\n64:       const ipAddress = req.headers.get('x-forwarded-for') || undefined;\r\n65:       const session = await createSession(result.user.id, userAgent, ipAddress);\r\n66: \r\n67:       const cookieStore = await cookies();\r\n68:       cookieStore.set('nagrikone_session_token', session.token, {\r\n69:         httpOnly: true,\r\n70:         secure: process.env.NODE_ENV === 'production',\r\n71:         sameSite: 'lax',\r\n72:         expires: session.expiresAt,\r\n73:         path: '/'\r\n74:       });\r\n75: \r\n76:       return NextResponse.json({\r\n77:         success: true,\r\n78:         message: 'Verified successfully.',\r\n79:         user: {\r\n80:           id: result.user.id,\r\n81:           name: result.user.name,\r\n82:           email: result.user.email,\r\n83:           phone: result.user.phone,\r\n84:           role: result.user.role\r\n85:         }\r\n86:       });\r\n87:     }\r\n88: \r\n89:     return NextResponse.json({ error: 'Invalid action. Specify \"send\" or \"verify\".' }, { status: 400 });\r\n90:   } catch (err: any) {\r\n91:     console.error('[API /auth/otp] Error:', err);\r\n92:     return NextResponse.json(\r\n93:       { error: 'Unable to process authentication request. Please try again.' },\r\n94:       { status: 500 }\r\n95:     );\r\n96:   }\r\n97: }\r\n98: \nThe above content shows the entire, complete file contents of the requested file.\n"}
{"step_index":67,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T16:46:58Z","input_tokens":2237,"cache_read_tokens":139596,"output_tokens":2234,"content":"Good — the OTP backend route is preserved unchanged. Now let me create the final comprehensive report:","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":"{\"RequestFeedback\":false,\"Summary\":\"Comprehensive final report of all NagrikOne auth redesign changes: files changed, features implemented, animations added, commands to run, and remaining setup steps.\",\"UserFacing\":true}","CodeContent":"\"# NagrikOne — Auth Redesign & Premium UI: Final Report\\n\\n## ✅ Files Changed\\n\\n| File | Change |\\n|------|--------|\\n| `prisma/schema.prisma` | Added `passwordHash String?` to `User` model |\\n| `lib/auth/passwordAuth.ts` | Full rewrite — email as primary identifier, saves `passwordHash` to DB, reads from DB on login, server-side confirm password |\\n| `app/api/auth/register/route.ts` | Updated to accept `email` (required), `confirmPassword` |\\n| `components/AuthModal.tsx` | **Full premium rewrite** — removed OTP tab, added show/hide passwords, password strength, confirm password, terms checkbox, glassmorphism card, ambient orb decorations |\\n| `app/login/page.tsx` | **Full premium rewrite** — two-column layout with animated civic network visual on left, glassmorphism auth card on right, all new fields, no OTP references |\\n| `app/globals.css` | +300 lines of premium CSS — auth field styles, auth button, civic animation keyframes, reduced-motion overrides |\\n\\n## ✅ Authentication Features Implemented\\n\\n### Sign Up\\n- **Full name** (required, min 2 chars)\\n- **Email address** (required — primary login identifier)\\n- **Mobile number** (optional contact field, no OTP verification)\\n- **Password** (min 8 chars, PBKDF2-hashed)\\n- **Confirm password** (server + client validation)\\n- **Password strength indicator** (Weak / Fair / Strong)\\n- **Show/hide password** toggles on both password fields\\n- **Terms & Privacy Policy checkbox** (blocks submission if unchecked)\\n- Inline validation errors before API call\\n- Creates real user account in DB with `passwordHash` persisted\\n- Sets 14-day HTTP-only session cookie on success\\n- Remember me localStorage storage\\n\\n### Sign In\\n- **Email or mobile** identifier\\n- **Password** with show/hide toggle\\n- **Remember me** checkbox\\n- \\\"Forgot password? Contact support.\\\" — honest placeholder (no fake reset flow)\\n- Real session validation against DB\\n- 14-day HTTP-only cookie\\n\\n### OTP — Preserved for Future\\n- `lib/auth/otp.ts` — **untouched**, fully funct\n<truncated 4989 bytes>","Description":"\"Comprehensive final implementation report\"","Overwrite":"false","TargetFile":"\"C:\\\\Users\\\\JAHID\\\\.gemini\\\\antigravity\\\\brain\\\\cbc8bff2-4be3-4f93-9be9-11c2e7ddb1fe\\\\final-report.md\"","toolAction":"\"Creating final report\"","toolSummary":"\"Implementation report\""}}],"truncated_fields":["tool_calls"]}
