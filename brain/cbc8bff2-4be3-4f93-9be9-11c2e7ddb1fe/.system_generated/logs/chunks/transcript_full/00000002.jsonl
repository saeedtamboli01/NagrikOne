r\n264:         method: 'POST',\r\n265:         headers: { 'Content-Type': 'application/json' },\r\n266:         body: JSON.stringify({\r\n267:           text: rawText,\r\n268:           location: customLocation || undefined,\r\n269:           history: conversation.map((c) => ({ sender: c.sender, text: c.text }))\r\n270:         })\r\n271:       });\r\n272: \r\n273:       const data = await res.json();\r\n274: \r\n275:       if (!res.ok || !data.success) {\r\n276:         throw new Error(data.error || 'Failed to analyze issue.');\r\n277:       }\r\n278: \r\n279:       const classification = data.classification || {};\r\n280:       const route = data.route || {};\r\n281:       const solution = data.solution || {};\r\n282:       const questions =\r\n283:         data.questions ||\r\n284:         data.dynamicQuestions ||\r\n285:         [];\r\n286: \r\n287:       const fullSolutionText =\r\n288:         data.chatResponse ||\r\n289:         solution.chatResponseText ||\r\n290:         (classification.summary\r\n291:           ? `${classification.summary} I've identified the relevant route as ${\r\n292:               route.targetDepartment || 'the relevant service or authority'\r\n293:             }.`\r\n294:           : `I understand. I've mapped this issue to ${\r\n295:               classification.domain || 'a citizen-support category'\r\n296:             }.`);\r\n297: \r\n298:       const spokenSummary = classification.summary\r\n299:         ? `${classification.summary} I've prepared your legal action plan and statutory notice draft.`\r\n300:         : `I've analyzed your situation and prepared an immediate legal solution.`;\r\n301: \r\n302:       setNovaState('CLASSIFYING');\r\n303:       setAnalysisResult({\r\n304:         ...data,\r\n305:         rawText,\r\n306:         classification,\r\n307:         route,\r\n308:         questions,\r\n309:         solution\r\n310:       });\r\n311: \r\n312:       setConversation(prev => [\r\n313:         ...prev,\r\n314:         {\r\n315:           sender: 'nova',\r\n316:           text: fullSolutionText,\r\n317:           noticeDraft: solution.formalNoticeDraft,\r\n318:           headline: solution.headline,\r\n319:           timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\r\n320:         }\r\n321:       ]);\r\n322: \r\n323:       if (voiceEnabled) {\r\n324:         speakText(spokenSummary);\r\n325:       } else {\r\n326:         setTimeout(() => setNovaState('IDLE'), 1800);\r\n327:       }\r\n328:     } catch (err: any) {\r\n329:       setErrorMessage(err.message || 'Error analyzing issue with NOVA.');\r\n330:       setNovaState('IDLE');\r\n331:     } finally {\r\n332:       setAnalyzing(false);\r\n333:     }\r\n334:   };\r\n335: \r\n336:   const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\r\n337:     const files = e.target.files;\r\n338:     if (!files || files.length === 0) return;\r\n339: \r\n340:     if (!user) {\r\n341:       setAuthPromptMessage('Before we start, please log in so I can securely save your problem, documents and case status.');\r\n342:       setAuthModalOpen(true);\r\n343:       return;\r\n344:     }\r\n345: \r\n346:     const file = files[0];\r\n347:     const formData = new FormData();\r\n348:     formData.append('file', file);\r\n349: \r\n350:     try {\r\n351:       const res = await fetch('/api/evidence', {\r\n352:         method: 'POST',\r\n353:         body: formData\r\n354:       });\r\n355: \r\n356:       const data = await res.json();\r\n357:       if (!res.ok || !data.success) {\r\n358:         throw new Error(data.error || 'Upload verification failed.');\r\n359:       }\r\n360: \r\n361:       setEvidenceFiles((prev) => [...prev, data.file]);\r\n362:     } catch (err: any) {\r\n363:       setErrorMessage(err.message || 'Could not upload evidence file.');\r\n364:     }\r\n365:   };\r\n366: \r\n367:   const handleCreatePersistentCase = async () => {\r\n368:     if (!user) {\r\n369:       setAuthPromptMessage('Before we start, please log in so I can securely save your problem, documents and case status.');\r\n370:       setAuthModalOpen(true);\r\n371:       return;\r\n372:     }\r\n373: \r\n374:     if (!analysisResult) return;\r\n375: \r\n376:     setCreatingCase(true);\r\n377:     setErrorMessage(null);\r\n378:     setNovaState('THINKING');\r\n379: \r\n380:     try {\r\n381:       const classification = analysisResult.classification || {};\r\n382:       const route = analysisResult.route || {};\r\n383:       const isUnknown = classification.isUnknown || classification.domain === 'UNKNOWN' || classification.domain === 'Unclassified / General Citizen Dispute';\r\n384: \r\n385:       const problemText = (analysisResult.rawText || inputProblem || 'Citizen issue').trim();\r\n386:       const res = await fetch('/api/cases', {\r\n387:         method: 'POST',\r\n388:         headers: { 'Content-Type': 'application/json' },\r\n389:         body: JSON.stringify({\r\n390:           problemTypeId: isUnknown ? undefined : (classification.problemCode || classification.problemId || analysisResult.problem?.id),\r\n391:           title: isUnknown \r\n392:             ? `Dispute: ${problemText.slice(0, 50)}...`\r\n393:             : `${classification.domain || 'Citizen'} Issue`,\r\n394:           description: problemText,\r\n395:           location: customLocation || 'Unspecified Jurisdiction',\r\n396:           customAnswers: dynamicAnswers,\r\n397:           evidenceFiles: evidenceFiles,\r\n398:           routeRecommendation: route\r\n399:         })\r\n400:       });\r\n401: \r\n402:       const data = await res.json();\r\n403: \r\n404:       if (!res.ok || !data.success) {\r\n405:         throw new Error(data.error || 'Failed to create persistent case.');\r\n406:       }\r\n407: \r\n408:       setCreatedCase(data.case);\r\n409:       setNovaState('CASE_CREATED');\r\n410: \r\n411:       const successVoice = `Your case ${data.case.id} has been securely created. All statutory timelines and events are now actively tracked.`;\r\n412:       if (voiceEnabled) {\r\n413:         speakText(successVoice);\r\n414:       }\r\n415:     } catch (err: any) {\r\n416:       setErrorMessage(err.message || 'Could not create case.');\r\n417:       setNovaState('IDLE');\r\n418:     } finally {\r\n419:       setCreatingCase(false);\r\n420:     }\r\n421:   };\r\n422: \r\n423:   return (\r\n424:     <main className=\"min-h-screen bg-[#030712] text-slate-100 selection:bg-cyan-500 selection:text-slate-950 pb-24\">\r\n425:       <Navbar\r\n426:         user={user}\r\n427:         onOpenAuth={() => setAuthModalOpen(true)}\r\n428:         onLogout={async () => {\r\n429:           await fetch('/api/auth/session', { method: 'DELETE' });\r\n430:           setUser(null);\r\n431:         }}\r\n432:       />\r\n433: \r\n434:       <AuthModal\r\n435:         isOpen={authModalOpen}\r\n436:         onClose={() => setAuthModalOpen(false)}\r\n437:         customPrompt={authPromptMessage}\r\n438:         onLoginSuccess={(u) => {\r\n439:           setUser(u);\r\n440:           setAuthPromptMessage(undefined);\r\n441:         }}\r\n442:       />\r\n443: \r\n444:       <div className=\"container-box pt-8 sm:pt-12 max-w-5xl\">\r\n445:         \r\n446:         {/* ============================================================ */}\r\n447:         {/* CENTRAL NOVA INTELLIGENCE EXPERIENCE                          */}\r\n448:         {/* ============================================================ */}\r\n449:         <div className=\"flex flex-col items-center justify-center text-center space-y-4 mb-6\">\r\n450:           <div className=\"inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 text-xs font-mono\">\r\n451:             <Sparkles className=\"w-3.5 h-3.5\" />\r\n452:             <span>NOVA CITIZEN INTELLIGENCE</span>\r\n453:           </div>\r\n454: \r\n455:           <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-black text-slate-50 tracking-tight\">\r\n456:             Tell NOVA what you're facing.\r\n457:           </h1>\r\n458: \r\n459:           {/* Dominant Living 3D Core */}\r\n460:           <div className=\"py-2\">\r\n461:             <NovaHeroCore\r\n462:               state={novaState}\r\n463:               amplitude={micAmplitude}\r\n464:               size=\"hero\"\r\n465:               onCoreClick={() => {\r\n466:                 if (isSpeaking) handleStopSpeaking();\r\n467:                 else handleToggleMic();\r\n468:               }}\r\n469:             />\r\n470:           </div>\r\n471: \r\n472:           {/* Voice Controls Bar */}\r\n473:           <div className=\"flex items-center gap-3\">\r\n474:             <button\r\n475:               onClick={handleToggleMic}\r\n476:               className={`px-5 py-2.5 rounded-full font-bold text-xs flex items-center gap-2 transition-all ${\r\n477:                 isListening\r\n478:                   ? 'bg-rose-600 text-white shadow-[0_0_20px_rgba(225,29,72,0.5)] animate-pulse'\r\n479:                   : 'bg-slate-900 border border-slate-700 hover:border-cyan-400 text-slate-200'\r\n480:               }`}\r\n481:             >\r\n482:               {isListening ? <MicOff className=\"w-4 h-4\" /> : <Mic className=\"w-4 h-4 text-cyan-400\" />}\r\n483:               <span>{isListening ? 'Stop Listening' : 'Speak to NOVA'}</span>\r\n484:             </button>\r\n485: \r\n486:             {isSpeaking && (\r\n487:               <button\r\n488:                 onClick={handleStopSpeaking}\r\n489:                 className=\"px-4 py-2.5 rounded-full bg-slate-900 border border-amber-500/40 text-amber-300 font-bold text-xs flex items-center gap-1.5\"\r\n490:               >\r\n491:                 <Square className=\"w-3.5 h-3.5\" />\r\n492:                 <span>Stop Voice</span>\r\n493:               </button>\r\n494:             )}\r\n495: \r\n496:             <button\r\n497:               onClick={() => setVoiceEnabled(!voiceEnabled)}\r\n498:               title={voiceEnabled ? 'Voice Responses Enabled' : 'Voice Responses Muted'}\r\n499:               className=\"p-2.5 rounded-full bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-400\"\r\n500:             >\r\n501:               {voiceEnabled ? <Volume2 className=\"w-4 h-4 text-cyan-400\" /> : <VolumeX className=\"w-4 h-4\" />}\r\n502:             </button>\r\n503:           </div>\r\n504:         </div>\r\n505: \r\n506:         {/* ============================================================ */}\r\n507:         {/* CONVERSATION TRANSCRIPT & INPUT AREA                          */}\r\n508:         {/* ============================================================ */}\r\n509:         <div className=\"rounded-3xl p-5 sm:p-7 bg-gradient-to-b from-[#081322] to-[#040914] border border-slate-800/80 shadow-2xl space-y-6 mb-8\">\r\n510:           \r\n511:           {/* Transcript Feed */}\r\n512:           <div className=\"space-y-4 min-h-[220px] max-h-[560px] overflow-y-auto pr-2 custom-scrollbar\">\r\n513:             {conversation.map((turn, idx) => (\r\n514:               <div\r\n515:                 key={idx}\r\n516:                 className={`flex gap-3 text-xs sm:text-sm ${\r\n517:                   turn.sender === 'citizen' ? 'justify-end' : 'justify-start'\r\n518:                 }`}\r\n519:               >\r\n520:                 <div\r\n521:                   className={`max-w-[92%] sm:max-w-[85%] rounded-2xl p-4 leading-relaxed font-sans ${\r\n522:                     turn.sender === 'citizen'\r\n523:                       ? 'bg-gradient-to-r from-cyan-600 to-blue-600 text-slate-950 font-semibold'\r\n524:                       : 'bg-slate-900/95 border border-slate-800 text-slate-200 shadow-lg'\r\n525:                   }`}\r\n526:                 >\r\n527:                   {turn.headline && (\r\n528:                     <div className=\"mb-2\">\r\n529:                       <span className=\"px-2.5 py-0.5 rounded-full text-[10.5px] font-mono font-bold bg-cyan-950 border border-cyan-500/40 text-cyan-300\">\r\n530:                         {turn.headline}\r\n531:                       </span>\r\n532:                     </div>\r\n533:                   )}\r\n534: \r\n535:                   <div className=\"whitespace-pre-wrap leading-relaxed space-y-2 text-xs sm:text-sm text-slate-200 font-sans\">\r\n536:                     {turn.text}\r\n537:                   </div>\r\n538: \r\n539:                   {turn.noticeDraft && (\r\n540:                     <div className=\"mt-3.5 pt-3 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-2 bg-slate-950/70 p-3 rounded-xl border border-slate-800\">\r\n541:                       <div className=\"flex items-center gap-1.5 text-[11px] font-mono text-emerald-400 font-bold\">\r\n542:                         <FileText className=\"w-3.5 h-3.5\" />\r\n543:                         <span>Statutory Legal Notice Ready</span>\r\n544:                       </div>\r\n545:                       <button\r\n546:                         type=\"button\"\r\n547:                         onClick={() => {\r\n548:                           navigator.clipboard.writeText(turn.noticeDraft!);\r\n549:                           setCopiedTurnIdx(idx);\r\n550:                           setTimeout(() => setCopiedTurnIdx(null), 2500);\r\n551:                         }}\r\n552:                         className=\"px-3 py-1.5 rounded-lg bg-cyan-950 hover:bg-cyan-900 border border-cyan-500/40 text-cyan-300 font-mono text-xs flex items-center gap-1.5 transition-all shadow-sm\"\r\n553:                       >\r\n554:                         {copiedTurnIdx === idx ? (\r\n555:                           <>\r\n556:                             <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\r\n557:                             <span>Notice Copied!</span>\r\n558:                           </>\r\n559:                         ) : (\r\n560:                           <>\r\n561:                             <Copy className=\"w-3.5 h-3.5\" />\r\n562:                             <span>Copy Legal Notice</span>\r\n563:                           </>\r\n564:                         )}\r\n565:                       </button>\r\n566:                     </div>\r\n567:                   )}\r\n568: \r\n569:                   <span className=\"text-[10px] opacity-60 block mt-2 text-right font-mono\">\r\n570:                     {turn.timestamp}\r\n571:                   </span>\r\n572:                 </div>\r\n573:               </div>\r\n574:             ))}\r\n575:             <div ref={transcriptEndRef} />\r\n576:           </div>\r\n577: \r\n578:           {/* Interactive Input Form */}\r\n579:           <div className=\"space-y-3 pt-2 border-t border-slate-800/80\">\r\n580:             <div className=\"flex flex-col sm:flex-row gap-3\">\r\n581:               <input\r\n582:                 type=\"text\"\r\n583:                 value={inputProblem}\r\n584:                 onChange={(e) => setInputProblem(e.target.value)}\r\n585:                 onKeyDown={(e) => {\r\n586:                   if (e.key === 'Enter') runTriage(inputProblem);\r\n587:                 }}\r\n588:                 placeholder=\"Type your issue... (e.g. My landlord refuses to return my ₹45,000 security deposit)\"\r\n589:                 className=\"w-full bg-slate-900/90 border border-slate-700/80 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-100 placeholder:text-slate-500 outline-none focus:border-cyan-400 font-sans\"\r\n590:               />\r\n591: \r\n592:               <button\r\n593:                 onClick={() => runTriage(inputProblem)}\r\n594:                 disabled={analyzing}\r\n595:                 className=\"px-6 py-3 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-extrabold text-xs flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(6,182,212,0.3)] whitespace-nowrap transition-all disabled:opacity-50\"\r\n596:               >\r\n597:                 {analyzing ? (\r\n598:                   <>\r\n599:                     <RefreshCw className=\"w-4 h-4 animate-spin\" />\r\n600:                     <span>Analyzing...</span>\r\n601:                   </>\r\n602:                 ) : (\r\n603:                   <>\r\n604:                     <span>Analyze Issue</span>\r\n605:                     <Send className=\"w-3.5 h-3.5\" />\r\n606:                   </>\r\n607:                 )}\r\n608:               </button>\r\n609:             </div>\r\n610: \r\n611:             <div className=\"flex items-center gap-2\">\r\n612:               <MapPin className=\"w-3.5 h-3.5 text-slate-500\" />\r\n613:               <input\r\n614:                 type=\"text\"\r\n615:                 value={customLocation}\r\n616:                 onChange={(e) => setCustomLocation(e.target.value)}\r\n617:                 placeholder=\"Optional Location / City (e.g. Pune, Maharashtra)\"\r\n618:                 className=\"w-full bg-transparent text-xs text-slate-400 placeholder:text-slate-600 outline-none font-mono\"\r\n619:               />\r\n620:             </div>\r\n621: \r\n622:             {errorMessage && (\r\n623:               <div className=\"p-3 rounded-xl bg-rose-950/40 border border-rose-500/40 text-rose-300 text-xs flex items-center gap-2\">\r\n624:                 <AlertTriangle className=\"w-4 h-4 shrink-0\" />\r\n625:                 <span>{errorMessage}</span>\r\n626:               </div>\r\n627:             )}\r\n628:           </div>\r\n629:         </div>\r\n630: \r\n631:         {/* ============================================================ */}\r\n632:         {/* ANALYSIS RESULT & DYNAMIC QUESTIONS SECTION                  */}\r\n633:         {/* ============================================================ */}\r\n634:         {analysisResult && (\r\n635:           <div className=\"space-y-6 animate-fade-in\">\r\n636:             \r\n637:             {/* Structured Solution Header */}\r\n638:             <div className=\"rounded-3xl p-6 sm:p-8 bg-gradient-to-b from-[#081322] to-[#040914] border border-cyan-500/30 shadow-xl space-y-5\">\r\n639:               <div className=\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800\">\r\n640:                 <div className=\"flex items-center gap-2\">\r\n641:                   <span className=\"px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-500/40 text-cyan-300 text-xs font-mono font-bold\">\r\n642:                     {analysisResult.classification?.domain || 'General Citizen Issue'}\r\n643:                   </span>\r\n644:                   <span className=\"text-xs font-mono text-slate-400\">\r\n645:                     Confidence: {Math.round((analysisResult.classification?.confidence || 0.8) * 100)}%\r\n646:                   </span>\r\n647:                 </div>\r\n648: \r\n649:                 <div className=\"text-xs font-mono text-emerald-400 flex items-center gap-1.5\">\r\n650:                   <Clock3 className=\"w-4 h-4\" />\r\n651:                   <span>Statutory SLA: {analysisResult.route?.estimatedSlaDays || 5} Days</span>\r\n652:                 </div>\r\n653:               </div>\r\n654: \r\n655:               {/* Solution Overview */}\r\n656:               <div className=\"space-y-3\">\r\n657:                 <h2 className=\"text-xl sm:text-2xl font-black text-slate-50\">\r\n658:                   Recommended Statutory Path\r\n659:                 </h2>\r\n660:                 <p className=\"text-xs sm:text-sm text-slate-300 leading-relaxed font-sans\">\r\n661:                   {analysisResult.route?.actionPlan || 'Review the case details and follow statutory procedures.'}\r\n662:                 </p>\r\n663:               </div>\r\n664: \r\n665:               {/* Target Authority & Checklist */}\r\n666:               <div className=\"grid sm:grid-cols-2 gap-4 pt-2\">\r\n667:                 <div className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-1.5\">\r\n668:                   <span className=\"text-[10px] font-mono text-slate-500 uppercase tracking-wider block\">Target Authority</span>\r\n669:                   <strong className=\"text-sm text-cyan-300 font-bold block\">{analysisResult.route?.targetDepartment || 'Relevant Authority'}</strong>\r\n670:                   <span className=\"text-xs text-slate-400 block\">{analysisResult.route?.statutoryFramework || 'Citizen Charter / Statutory Rules'}</span>\r\n671:                 </div>\r\n672: \r\n673:                 <div className=\"p-4 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-1.5\">\r\n674:                   <span className=\"text-[10px] font-mono text-slate-500 uppercase tracking-wider block\">Next Immediate Step</span>\r\n675:                   <strong className=\"text-sm text-emerald-300 font-bold block\">{analysisResult.route?.nextImmediateStep || 'Prepare required documentation'}</strong>\r\n676:                   <span className=\"text-xs text-slate-400 block\">{analysisResult.route?.legalNoticeRecommended ? 'Legal Notice / Formal Dispute Recommended' : 'Direct Statutory Submission Available'}</span>\r\n677:                 </div>\r\n678:               </div>\r\n679:             </div>\r\n680: \r\n681:             {/* Dynamic Contextual Questions */}\r\n682:             {((analysisResult.questions || []).length > 0) && (\r\n683:               <div className=\"rounded-3xl p-6 sm:p-8 bg-gradient-to-b from-[#081322] to-[#040914] border border-slate-800 space-y-6\">\r\n684:                 <div className=\"space-y-1\">\r\n685:                   <h3 className=\"text-lg font-black text-slate-100 flex items-center gap-2\">\r\n686:                     <HelpCircle className=\"w-5 h-5 text-cyan-400\" />\r\n687:                     <span>Case Fact Verification</span>\r\n688:                   </h3>\r\n689:                   <p className=\"text-xs text-slate-400\">\r\n690:                     NOVA requires these essential details to prepare your formal case docket accurately.\r\n691:                   </p>\r\n692:                 </div>\r\n693: \r\n694:                 <div className=\"grid sm:grid-cols-2 gap-4\">\r\n695:                   {(analysisResult.questions || []).map((q: DynamicQuestion) => (\r\n696:                     <div key={q.id} className=\"p-4 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2\">\r\n697:                       <label className=\"text-xs font-bold text-slate-200 block\">\r\n698:                         {q.question} {q.required && <span className=\"text-rose-400\">*</span>}\r\n699:                       </label>\r\n700: \r\n701:                       {q.type === 'choice' && q.options ? (\r\n702:                         <select\r\n703:                           value={dynamicAnswers[q.id] || ''}\r\n704:                           onChange={(e) => setDynamicAnswers({ ...dynamicAnswers, [q.id]: e.target.value })}\r\n705:                           className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 outline-none focus:border-cyan-400 font-sans\"\r\n706:                         >\r\n707:                           <option value=\"\">Select option...</option>\r\n708:                           {q.options.map((opt, i) => (\r\n709:                             <option key={i} value={opt}>{opt}</option>\r\n710:                           ))}\r\n711:                         </select>\r\n712:                       ) : q.type === 'boolean' ? (\r\n713:                         <div className=\"flex gap-2\">\r\n714:                           {['Yes', 'No'].map((opt) => (\r\n715:                             <button\r\n716:                               key={opt}\r\n717:                               type=\"button\"\r\n718:                               onClick={() => setDynamicAnswers({ ...dynamicAnswers, [q.id]: opt })}\r\n719:                               className={`flex-1 py-1.5 rounded-xl border text-xs font-bold transition-all ${\r\n720:                                 dynamicAnswers[q.id] === opt\r\n721:                                   ? 'bg-cyan-950 border-cyan-400 text-cyan-300'\r\n722:                                   : 'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700'\r\n723:                               }`}\r\n724:                             >\r\n725:                               {opt}\r\n726:                             </button>\r\n727:                           ))}\r\n728:                         </div>\r\n729:                       ) : (\r\n730:                         <input\r\n731:                           type=\"text\"\r\n732:                           placeholder={q.placeholder || 'Your answer...'}\r\n733:                           value={dynamicAnswers[q.id] || ''}\r\n734:                           onChange={(e) => setDynamicAnswers({ ...dynamicAnswers, [q.id]: e.target.value })}\r\n735:                           className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 placeholder:text-slate-600 outline-none focus:border-cyan-400 font-sans\"\r\n736:                         />\r\n737:                       )}\r\n738: \r\n739:                       {q.helpText && (\r\n740:                         <span className=\"text-[10px] text-slate-500 block font-mono\">{q.helpText}</span>\r\n741:                       )}\r\n742:                     </div>\r\n743:                   ))}\r\n744:                 </div>\r\n745:               </div>\r\n746:             )}\r\n747: \r\n748:             {/* Evidence Attachment Section */}\r\n749:             <div className=\"rounded-3xl p-6 sm:p-8 bg-gradient-to-b from-[#081322] to-[#040914] border border-slate-800 space-y-4\">\r\n750:               <div className=\"flex items-center justify-between\">\r\n751:                 <div>\r\n752:                   <h3 className=\"text-base font-black text-slate-100 flex items-center gap-2\">\r\n753:                     <UploadCloud className=\"w-5 h-5 text-cyan-400\" />\r\n754:                     <span>Evidence & Document Verification</span>\r\n755:                   </h3>\r\n756:                   <p className=\"text-xs text-slate-400\">\r\n757:                     Attach receipts, screenshots, notices, or photographs to strengthen statutory enforceability.\r\n758:                   </p>\r\n759:                 </div>\r\n760: \r\n761:                 <button\r\n762:                   type=\"button\"\r\n763:                   onClick={() => fileInputRef.current?.click()}\r\n764:                   className=\"px-4 py-2 rounded-xl bg-slate-900 border border-slate-700 hover:border-cyan-400 text-slate-200 text-xs font-bold flex items-center gap-1.5 transition-colors\"\r\n765:                 >\r\n766:                   <Camera className=\"w-3.5 h-3.5 text-cyan-400\" />\r\n767:                   <span>Upload File</span>\r\n768:                 </button>\r\n769:                 <input\r\n770:                   ref={fileInputRef}\r\n771:                   type=\"file\"\r\n772:                   onChange={handleFileUpload}\r\n773:                   className=\"hidden\"\r\n774:                   accept=\"image/png,image/jpeg,image/webp,application/pdf\"\r\n775:                 />\r\n776:               </div>\r\n777: \r\n778:               {evidenceFiles.length > 0 ? (\r\n779:                 <div className=\"space-y-2 pt-2\">\r\n780:                   {evidenceFiles.map((f, i) => (\r\n781:                     <div key={i} className=\"p-3 rounded-xl bg-slate-900/90 border border-slate-800 flex items-center justify-between text-xs\">\r\n782:                       <div className=\"flex items-center gap-2 text-slate-200\">\r\n783:                         <FileCheck className=\"w-4 h-4 text-emerald-400\" />\r\n784:                         <span className=\"font-semibold truncate max-w-xs\">{f.name}</span>\r\n785:                         <span className=\"text-[10px] text-slate-500 font-mono\">({Math.round(f.size / 1024)} KB)</span>\r\n786:                       </div>\r\n787:                       <span className=\"text-[10px] text-emerald-400 font-mono uppercase\">Verified</span>\r\n788:                     </div>\r\n789:                   ))}\r\n790:                 </div>\r\n791:               ) : (\r\n792:                 <div className=\"p-4 rounded-2xl bg-slate-900/40 border border-dashed border-slate-800 text-center text-xs text-slate-500 font-mono\">\r\n793:                   No files attached yet. (PDF, JPG, PNG up to 10MB)\r\n794:                 </div>\r\n795:               )}\r\n796:             </div>\r\n797: \r\n798:             {/* Persistent Case Creation Action */}\r\n799:             <div className=\"pt-4 flex flex-col sm:flex-row items-center justify-between gap-4\">\r\n800:               <div className=\"text-xs text-slate-400 font-mono\">\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":35,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T16:36:03Z","input_tokens":29894,"cache_read_tokens":77180,"output_tokens":1533,"content":"I now have a comprehensive understanding of the entire codebase. Let me create an analysis artifact and then spawn a subagent to do the implementation work:","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Deep codebase analysis of NagrikOne repository, including current auth architecture, critical issues found (passwordHash not persisted to DB), and detailed implementation plan for the premium auth redesign.","UserFacing":true},"CodeContent":"# NagrikOne — Deep Codebase Analysis & Implementation Plan\n\n## Current Architecture\n\n### Tech Stack\n- **Framework**: Next.js 15 (App Router, `use client` pages)\n- **Database**: PostgreSQL via Prisma ORM (v6.19.3)\n- **Styling**: Tailwind CSS v3 + custom CSS in `globals.css`\n- **Fonts**: Plus Jakarta Sans + JetBrains Mono (Google Fonts)\n- **Icons**: Lucide React\n- **Validation**: Zod\n- **Auth**: Custom session system (PBKDF2 passwords, HMAC token hashing)\n- **3D**: Custom CSS/SVG-based components (`NovaHeroCore`, `ServiceCards3D`)\n- **No Three.js / no Framer Motion** — animations are CSS-only\n\n### Current Authentication System\n**Working**: Password-based register/login is FULLY implemented:\n- `lib/auth/passwordAuth.ts` — PBKDF2 hashing, `registerCitizen()`, `loginCitizen()`\n- `lib/auth/session.ts` — HMAC token, 14-day session cookies\n- `app/api/auth/register/route.ts` — POST endpoint\n- `app/api/auth/login/route.ts` — POST endpoint\n- `app/api/auth/session/route.ts` — GET (check session) + DELETE (logout)\n\n**OTP system**: Exists in `lib/auth/otp.ts` + `app/api/auth/otp/route.ts` — fully working backend, but UI has it exposed as \"SMS OTP\" tab.\n\n### Current Issues to Fix\n1. **AuthModal** (components/AuthModal.tsx): Has 3 tabs — Sign In, Create Account, **SMS OTP** (must remove SMS OTP tab from UI)\n2. **Login Page** (app/login/page.tsx): Same 3-tab structure with SMS OTP tab visible\n3. **Sign Up missing**: Confirm password, Terms checkbox, show/hide password toggle\n4. **Sign In missing**: Show/hide password toggle, proper Forgot Password placeholder\n5. **Both pages**: Need premium visual redesign with 3D animated elements\n\n### Database Schema (Key Models)\n- `User`: id, name, email (unique), phone (unique), role, isActive, passwordHash field NOT in DB schema (stored in memory/session only — critical!)\n- `Session`: tokenHash, userId, expiresAt\n- `OtpVerification`: preserved for future use\n\n> **CRITICAL**: The `passwordHash` field is NOT in the Prisma User model! It's only in the in-memory fallback store. This means password auth only works until server restarts. Need to add `passwordHash String?` to User model.\n\n## Files to Change\n\n### 1. Prisma Schema — Add passwordHash to User\n`prisma/schema.prisma` → Add `passwordHash String?` to User model\n\n### 2. Password Auth — Save hash to DB\n`lib/auth/passwordAuth.ts` → Save passwordHash in DB during register, read from DB during login\n\n### 3. AuthModal — Remove OTP tab, Add premium UI\n`components/AuthModal.tsx` → Full premium redesign, remove OTP tab\n\n### 4. Login Page — Premium redesign\n`app/login/page.tsx` → Full premium redesign matching AuthModal\n\n### 5. Global CSS — Add new animation utilities\n`app/globals.css` → Add 3D animation keyframes, glass effects, orb animations\n\n### 6. Navbar — Minor polish\n`components/Navbar.tsx` → Sign Up button → link to `/login?tab=signup`\n\n## Visual Design System\n\n### Color Palette\n- Background: `#030712` (deep midnight navy)  \n- Card surfaces: `from-[#081322] to-[#040914]`\n- Accent: `#06b6d4` (cyan), `#3b82f6` (blue), `#a855f7` (violet hints)\n- Text: `#f8fafc` primary, `#94a3b8` muted\n\n### New Auth Page Layout: Two-Column Split\n- **Left**: Animated 3D visual — floating orbs, civic network illustration, NagrikOne branding\n- **Right**: Glassmorphism auth card with form\n\n### 3D Animations (CSS-only, no heavy libs)\n- Slow-rotating gradient orbs using `@keyframes`\n- Floating civic network nodes (SVG + CSS)\n- Parallax tilt on auth card (CSS perspective)\n- Smooth tab transitions with `transition-all`\n- Field focus animations (border glow)\n- Button press feedback (scale transform)\n\n## Implementation Order\n1. Fix Prisma schema (add passwordHash)\n2. Update passwordAuth.ts to persist hash\n3. Rewrite AuthModal (remove OTP tab, premium UI)\n4. Rewrite login page (premium two-column layout)\n5. Enhance globals.css (3D animation utilities)\n6. Run db:push to apply schema changes\n7. Install deps if needed\n8. Build/lint check\n","Description":"Analysis and implementation plan artifact","Overwrite":false,"TargetFile":"C:\\Users\\JAHID\\.gemini\\antigravity\\brain\\cbc8bff2-4be3-4f93-9be9-11c2e7ddb1fe\\analysis.md","toolAction":"Creating analysis artifact","toolSummary":"Codebase analysis doc"}}]}
