otp_verify' && (\r\n557:             <form onSubmit={handleVerifyOtp} className=\"space-y-5\">\r\n558:               <div>\r\n559:                 <div className=\"flex items-center justify-between px-1 mb-2.5 text-[11px] font-mono\">\r\n560:                   <span className=\"text-slate-400 uppercase tracking-wider\">SMS Code Sent</span>\r\n561:                   <span className={expiryCountdown > 30 ? 'text-cyan-400 font-bold' : 'text-rose-400 font-bold'}>\r\n562:                     {expiryCountdown > 0\r\n563:                       ? `Live: ${Math.floor(expiryCountdown / 60)}:${(expiryCountdown % 60).toString().padStart(2, '0')}`\r\n564:                       : 'Code Expired'}\r\n565:                   </span>\r\n566:                 </div>\r\n567: \r\n568:                 <div className=\"flex justify-center gap-2\">\r\n569:                   {[0, 1, 2, 3, 4, 5].map((idx) => (\r\n570:                     <input\r\n571:                       key={idx}\r\n572:                       id={`login-otp-${idx}`}\r\n573:                       type=\"text\"\r\n574:                       maxLength={6}\r\n575:                       value={otp[idx]}\r\n576:                       onChange={(e) => handleOtpChange(idx, e.target.value)}\r\n577:                       className=\"w-10 h-12 text-center text-lg font-mono font-bold bg-slate-900 border border-slate-700 rounded-xl text-cyan-300 focus:border-cyan-400 focus:outline-none\"\r\n578:                     />\r\n579:                   ))}\r\n580:                 </div>\r\n581:               </div>\r\n582: \r\n583:               <div className=\"flex items-center justify-between text-xs text-slate-400 font-mono\">\r\n584:                 <span>{cooldown > 0 ? `Resend SMS in ${cooldown}s` : \"Didn't receive code?\"}</span>\r\n585:                 {cooldown === 0 && (\r\n586:                   <button\r\n587:                     type=\"button\"\r\n588:                     onClick={handleSendOtp}\r\n589:                     className=\"text-cyan-400 hover:underline\"\r\n590:                   >\r\n591:                     Resend Code\r\n592:                   </button>\r\n593:                 )}\r\n594:               </div>\r\n595: \r\n596:               <button\r\n597:                 type=\"submit\"\r\n598:                 disabled={loading}\r\n599:                 className=\"w-full py-3 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-xs flex items-center justify-center gap-2 shadow-[0_4px_20px_rgba(6,182,212,0.3)] transition-all disabled:opacity-50\"\r\n600:               >\r\n601:                 {loading ? (\r\n602:                   <>\r\n603:                     <RefreshCw className=\"w-4 h-4 animate-spin\" />\r\n604:                     <span>Verifying Code...</span>\r\n605:                   </>\r\n606:                 ) : (\r\n607:                   <>\r\n608:                     <CheckCircle2 className=\"w-4 h-4\" />\r\n609:                     <span>Verify & Access Case Intelligence</span>\r\n610:                   </>\r\n611:                 )}\r\n612:               </button>\r\n613: \r\n614:               <button\r\n615:                 type=\"button\"\r\n616:                 onClick={() => setTab('signin')}\r\n617:                 className=\"w-full text-center text-xs text-slate-400 hover:text-slate-200 font-mono\"\r\n618:               >\r\n619:                 ← Back to Password Sign In\r\n620:               </button>\r\n621:             </form>\r\n622:           )}\r\n623: \r\n624:           <div className=\"mt-6 pt-4 border-t border-slate-800/80 text-center text-[10px] text-slate-500 font-mono flex items-center justify-center gap-1.5\">\r\n625:             <ShieldCheck className=\"w-3.5 h-3.5 text-cyan-400\" />\r\n626:             <span>Server-Side Encrypted Session • Privacy Safeguarded</span>\r\n627:           </div>\r\n628:         </div>\r\n629:       </div>\r\n630:     </main>\r\n631:   )