ptEndRef = useRef<HTMLDivElement | null>(null);\r\n91: \r\n92:   const audioAnalyzerRef = useRef<MicAudioAnalyzer | null>(null);\r\n93:   const animFrameRef = useRef<number | null>(null);\r\n94: \r\n95:   // Auto-scroll transcript feed\r\n96:   useEffect(() => {\r\n97:     transcriptEndRef.current?.scrollIntoView({ behavior: 'smooth' });\r\n98:   }, [conversation]);\r\n99: \r\n100:   // Check current user session\r\n101:   useEffect(() => {\r\n102:     async function checkSession() {\r\n103:       try {\r\n104:         const res = await fetch('/api/auth/session');\r\n105:         const data = await res.json();\r\n106:         if (data.authenticated && data.user) {\r\n107:           setUser(data.user);\r\n108:         }\r\n109:       } catch (err) {\r\n110:         console.warn('Session check failed:', err);\r\n111:       }\r\n112:     }\r\n113:     checkSession();\r\n114: \r\n115:     // Initial greeting if no input\r\n116:     if (!initialQuery) {\r\n117:       const greeting = \"Hello! I am NOVA. Tell me what problem you are facing, and I will help you identify the right statutory path and next step.\";\r\n118:       setConversation([{\r\n119:         sender: 'nova',\r\n120:         text: greeting,\r\n121:         timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\r\n122:       }]);\r\n123:     }\r\n124:   }, [initialQuery]);\r\n125: \r\n126:   // Audio amplitude polling loop when listening\r\n127:   const startAudioMeter = async () => {\r\n128:     if (!audioAnalyzerRef.current) {\r\n129:       audioAnalyzerRef.current = new MicAudioAnalyzer();\r\n130:     }\r\n131:     const started = await audioAnalyzerRef.current.start();\r\n132:     if (started) {\r\n133:       const updateAmp = () => {\r\n134:         if (audioAnalyzerRef.current) {\r\n135:           const amp = audioAnalyzerRef.current.getAmplitude();\r\n136:           setMicAmplitude(amp);\r\n137:           animFrameRef.current = requestAnimationFrame(updateAmp);\r\n138:  