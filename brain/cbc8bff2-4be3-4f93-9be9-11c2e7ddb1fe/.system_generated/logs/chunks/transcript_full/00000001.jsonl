mail(parsed.email || '');\r\n55:           if (parsed.name) setName(parsed.name);\r\n56:         }\r\n57:       }\r\n58:     } catch (e) {}\r\n59:   }, []);\r\n60: \r\n61:   // OTP countdown timer\r\n62:   useEffect(() => {\r\n63:     let timer: any;\r\n64:     if (tab === 'otp_verify') {\r\n65:       timer = setInterval(() => {\r\n66:         setCooldown((prev) => Math.max(0, prev - 1));\r\n67:         setExpiryCountdown((prev) => Math.max(0, prev - 1));\r\n68:       }, 1000);\r\n69:     }\r\n70:     return () => clearInterval(timer);\r\n71:   }, [tab]);\r\n72: \r\n73:   const saveRememberedCitizen = (userData: any) => {\r\n74:     if (!rememberMe) return;\r\n75:     try {\r\n76:       localStorage.setItem('nagrikone_saved_citizen', JSON.stringify({\r\n77:         name: userData.name,\r\n78:         phone: userData.phone,\r\n79:         email: userData.email,\r\n80:         identifier: userData.phone || userData.email,\r\n81:         savedAt: new Date().toISOString()\r\n82:       }));\r\n83:     } catch (e) {}\r\n84:   };\r\n85: \r\n86:   const handlePasswordLogin = async (e: React.FormEvent) => {\r\n87:     e.preventDefault();\r\n88:     setError(null);\r\n89:     setLoading(true);\r\n90: \r\n91:     try {\r\n92:       const res = await fetch('/api/auth/login', {\r\n93:         method: 'POST',\r\n94:         headers: { 'Content-Type': 'application/json' },\r\n95:         body: JSON.stringify({ identifier: identifier.trim(), password })\r\n96:       });\r\n97: \r\n98:       const data = await res.json();\r\n99:       if (!res.ok || !data.success) {\r\n100:         throw new Error(data.error || 'Invalid credentials. Please check your password.');\r\n101:       }\r\n102: \r\n103:       saveRememberedCitizen(data.user);\r\n104:       window.location.href = redirectUrl;\r\n105:     } catch (err: any) {\r\n106:       setError(err.message || 'Login failed. Please check your password.');\r\n107:     } finally {\r\n108:       setLoading(false);\r\n109:     }\r\n110:   };\r\n111: \r\n112:   const handleSignUp = async (e: React.FormEvent) => {\r\n113:     e.preventDefault();\r\n114:     setError(null);\r\n115:     setLoading(true);\r\n116: \r\n117:     try {\r\n118:       const res = await fetch('/api/auth/register', {\r\n119:         method: 'POST',\r\n120:         headers: { 'Content-Type': 'application/json' },\r\n121:         body: JSON.stringify({\r\n122:           name: name.trim(),\r\n123:           phone: phone.trim(),\r\n124:           email: email.trim() || undefined,\r\n125:           password\r\n126:         })\r\n127:       });\r\n128: \r\n129:       const data = await res.json();\r\n130:       if (!res.ok || !data.success) {\r\n131:         throw new Error(data.error || 'Registration failed.');\r\n132:       }\r\n133: \r\n134:       saveRememberedCitizen(data.user);\r\n135:       window.location.href = redirectUrl;\r\n136:     } catch (err: any) {\r\n137:       setError(err.message || 'Could not complete registration.');\r\n138:     } finally {\r\n139:       setLoading(false);\r\n140:     }\r\n141:   };\r\n142: \r\n143:   const handleSendOtp = async (e: React.FormEvent) => {\r\n144:     e.preventDefault();\r\n145:     setError(null);\r\n146:     const target = (phone || identifier).trim();\r\n147: \r\n148:     if (!target) {\r\n149:       setError('Please enter your 10-digit mobile number.');\r\n150:       return;\r\n151:     }\r\n152: \r\n153:     setLoading(true);\r\n154: \r\n155:     try {\r\n156:       const res = await fetch('/api/auth/otp', {\r\n157:         method: 'POST',\r\n158:         headers: { 'Content-Type': 'application/json' },\r\n159:         body: JSON.stringify({ action: 'send', target })\r\n160:       });\r\n161: \r\n162:       const data = await res.json();\r\n163:       if (!res.ok || !data.success) {\r\n164:         throw new Error(data.error || 'Unable to send OTP right now.');\r\n165:       }\r\n166: \r\n167:       setTab('otp_verify');\r\n168:       setCooldown(data.cooldownSeconds || 30);\r\n169:       setExpiryCountdown(data.expirySeconds || 180);\r\n170:       setSuccessMsg(`A 6-digit verification code has been dispatched to ${target}.`);\r\n171:     } catch (err: any) {\r\n172:       setError(err.message || 'Unable to send OTP.');\r\n173:     } finally {\r\n174:       setLoading(false);\r\n175:     }\r\n176:   };\r\n177: \r\n178:   const handleOtpChange = (index: number, val: string) => {\r\n179:     const digitsOnly = val.replace(/\\D/g, '');\r\n180:     if (digitsOnly.length > 1) {\r\n181:       const newOtp = [...otp];\r\n182:       for (let i = 0; i < 6 && i < digitsOnly.length; i++) {\r\n183:         newOtp[i] = digitsOnly[i];\r\n184:       }\r\n185:       setOtp(newOtp);\r\n186:       const lastIdx = Math.min(5, digitsOnly.length - 1);\r\n187:       document.getElementById(`login-otp-${lastIdx}`)?.focus();\r\n188:       return;\r\n189:     }\r\n190: \r\n191:     if (!/^\\d*$/.test(val)) return;\r\n192:     const newOtp = [...otp];\r\n193:     newOtp[index] = val.slice(-1);\r\n194:     setOtp(newOtp);\r\n195: \r\n196:     if (val && index < 5) {\r\n197:       document.getElementById(`login-otp-${index + 1}`)?.focus();\r\n198:     }\r\n199:   };\r\n200: \r\n201:   const handleVerifyOtp = async (e: React.FormEvent) => {\r\n202:     e.preventDefault();\r\n203:     setError(null);\r\n204:     const code = otp.join('');\r\n205:     const target = (phone || identifier).trim();\r\n206: \r\n207:     if (code.length < 6) {\r\n208:       setError('Please enter the full 6-digit verification code.');\r\n209:       return;\r\n210:     }\r\n211: \r\n212:     setLoading(true);\r\n213: \r\n214:     try {\r\n215:       const res = await fetch('/api/auth/otp', {\r\n216:         method: 'POST',\r\n217:         headers: { 'Content-Type': 'application/json' },\r\n218:         body: JSON.stringify({\r\n219:           action: 'verify',\r\n220:           target,\r\n221:           code,\r\n222:           name: name.trim() || undefined\r\n223:         })\r\n224:       });\r