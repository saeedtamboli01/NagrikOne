{"step_index":47,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T16:40:17Z","input_tokens":8865,"cache_read_tokens":120515,"output_tokens":3318,"content":"**Step 6: Update globals.css — Add all animation utilities for the premium auth UI and 3D effects**","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Adding all new animation keyframes, auth component classes (auth-field-wrap, auth-btn-primary, auth-checkbox, login-card), civic network 3D animation classes, and reduced-motion overrides.","EndLine":498,"Instruction":"Replace the print styles and end-of-file with augmented styles including all new auth and animation utilities","ReplacementContent":"/* Print Styles */\n@media print {\n  body {\n    background: #ffffff !important;\n    color: #000000 !important;\n  }\n  header, footer, nav, .btn-tool, .btn-primary-action, .filter-bar {\n    display: none !important;\n  }\n}\n\n/* ============================================================\n   PREMIUM AUTH COMPONENT STYLES\n   ============================================================ */\n\n/* Auth field input wrapper */\n.auth-field-wrap {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 11px 14px;\n  border-radius: 14px;\n  background: rgba(15, 23, 42, 0.7);\n  border: 1px solid rgba(148, 163, 184, 0.15);\n  transition: border-color 0.2s ease, box-shadow 0.2s ease;\n}\n\n.auth-field-wrap:focus-within {\n  border-color: rgba(6, 182, 212, 0.5);\n  box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.08);\n}\n\n/* Auth text input */\n.auth-field-input {\n  flex: 1;\n  background: transparent;\n  border: none;\n  outline: none;\n  font-size: 12.5px;\n  color: #f8fafc;\n  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;\n}\n\n.auth-field-input::placeholder {\n  color: #475569;\n}\n\n/* Primary auth button */\n.auth-btn-primary {\n  width: 100%;\n  padding: 13px 20px;\n  border-radius: 14px;\n  background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);\n  color: #030712;\n  font-weight: 800;\n  font-size: 12.5px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  box-shadow: 0 4px 20px rgba(6, 182, 212, 0.3);\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  border: none;\n  cursor: pointer;\n}\n\n.auth-btn-primary:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 8px 30px rgba(6, 182, 212, 0.45);\n  background: linear-gradient(135deg, #22d3ee 0%, #60a5fa 100%);\n}\n\n.auth-btn-primary:active:not(:disabled) {\n  transform: translateY(0);\n}\n\n.auth-btn-primary:disabled {\n  opacity: 0.55;\n  cursor: not-allowed;\n}\n\n/* Auth checkbox */\n.auth-checkbox {\n  width: 16px;\n  height: 16px;\n  border-radius: 5px;\n  border: 1px solid rgba(148, 163, 184, 0.35);\n  background: rgba(15, 23, 42, 0.7);\n  accent-color: #06b6d4;\n  cursor: pointer;\n  flex-shrink: 0;\n}\n\n/* Auth card (login page) */\n.login-card {\n  position: relative;\n  background: linear-gradient(160deg, #0d1f35 0%, #060d1a 50%, #030712 100%);\n  border: 1px solid rgba(56, 189, 248, 0.18);\n  border-radius: 28px;\n  padding: 36px;\n  box-shadow:\n    0 0 80px rgba(6, 182, 212, 0.12),\n    0 40px 80px rgba(0, 0, 0, 0.6);\n  overflow: hidden;\n}\n\n/* Auth modal enter animation */\n@keyframes authEnter {\n  from {\n    opacity: 0;\n    transform: scale(0.96) translateY(12px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n\n.animate-auth-enter {\n  animation: authEnter 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n/* ============================================================\n   CIVIC NETWORK 3D ANIMATION CLASSES\n   ============================================================ */\n\n/* Orb gradients */\n.civic-orb-primary {\n  background: radial-gradient(circle at center, rgba(6, 182, 212, 0.25) 0%, transparent 70%);\n  filter: blur(40px);\n  animation: orbFloat 8s ease-in-out infinite;\n}\n\n.civic-orb-secondary {\n  background: radial-gradient(circle at center, rgba(168, 85, 247, 0.2) 0%, transparent 70%);\n  filter: blur(30px);\n  animation: orbFloat 6s ease-in-out infinite reverse;\n}\n\n.civic-orb-tertiary {\n  background: radial-gradient(circle at center, rgba(16, 185, 129, 0.15) 0%, transparent 70%);\n  filter: blur(20px);\n  animation: orbFloat 10s ease-in-out infinite;\n}\n\n@keyframes orbFloat {\n  0%, 100% { transform: translateY(0) scale(1); }\n  50% { transform: translateY(-20px) scale(1.06); }\n}\n\n/* Ring animations */\n.civic-ring-outer {\n  border: 1.5px solid rgba(6, 182, 212, 0.3);\n  animation: ringRotate 20s linear infinite;\n}\n\n.civic-ring-middle {\n  border: 1px solid rgba(168, 85, 247, 0.2);\n  background: rgba(6, 182, 212, 0.03);\n  animation: ringPulse 4s ease-in-out infinite;\n}\n\n.civic-ring-inner {\n  background: radial-gradient(circle, rgba(6, 182, 212, 0.15) 0%, transparent 70%);\n  animation: orbFloat 3s ease-in-out infinite;\n}\n\n@keyframes ringRotate {\n  from { transform: rotate(0deg); }\n  to { transform: rotate(360deg); }\n}\n\n@keyframes ringPulse {\n  0%, 100% { opacity: 0.4; transform: scale(0.97); }\n  50% { opacity: 0.8; transform: scale(1); }\n}\n\n/* Floating node chips */\n.civic-node-chip {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  padding: 6px 10px;\n  border-radius: 20px;\n  background: rgba(8, 19, 34, 0.9);\n  border: 1px solid rgba(56, 189, 248, 0.2);\n  font-size: 10px;\n  font-family: 'JetBrains Mono', monospace;\n  color: #94a3b8;\n  white-space: nowrap;\n  backdrop-filter: blur(10px);\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);\n}\n\n.civic-float-1 { animation: chipFloat 5s ease-in-out infinite; }\n.civic-float-2 { animation: chipFloat 7s ease-in-out infinite reverse; }\n.civic-float-3 { animation: chipFloat 6s ease-in-out infinite 1s; }\n.civic-float-4 { animation: chipFloat 8s ease-in-out infinite reverse 0.5s; }\n\n@keyframes chipFloat {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-8px); }\n}\n\n/* SVG dash animations */\n.civic-dash-rotate {\n  transform-origin: 100px 100px;\n  animation: dashSpin 25s linear infinite;\n}\n\n.civic-dash-rotate-reverse {\n  transform-origin: 100px 100px;\n  animation: dashSpin 35s linear infinite reverse;\n}\n\n@keyframes dashSpin {\n  from { transform: rotate(0deg); }\n  to { transform: rotate(360deg); }\n}\n\n/* ============================================================\n   CARD HOVER & BUTTON EFFECTS\n   ============================================================ */\n\n/* Card hover elevation */\n.card-hover-lift {\n  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;\n}\n\n.card-hover-lift:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 0 0 30px rgba(6, 182, 212, 0.1);\n}\n\n/* Gradient text utility */\n.gradient-text-cyan {\n  background: linear-gradient(135deg, #34d399 0%, #38bdf8 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n/* Section entrance animation */\n@keyframes sectionSlideUp {\n  from {\n    opacity: 0;\n    transform: translateY(24px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.animate-section-enter {\n  animation: sectionSlideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n/* Soft shimmer effect for loading skeletons */\n@keyframes shimmer {\n  0% { background-position: -400px 0; }\n  100% { background-position: 400px 0; }\n}\n\n.skeleton-shimmer {\n  background: linear-gradient(90deg, #0d1f35 25%, #162c45 50%, #0d1f35 75%);\n  background-size: 800px 100%;\n  animation: shimmer 1.5s infinite;\n  border-radius: 8px;\n}\n\n/* Modal backdrop blur */\n.modal-backdrop {\n  background: rgba(3, 7, 18, 0.88);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n}\n\n/* ============================================================\n   REDUCED MOTION OVERRIDES\n   ============================================================ */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n  }\n\n  .civic-orb-primary,\n  .civic-orb-secondary,\n  .civic-orb-tertiary,\n  .civic-ring-outer,\n  .civic-ring-middle,\n  .civic-ring-inner,\n  .civic-float-1,\n  .civic-float-2,\n  .civic-float-3,\n  .civic-float-4,\n  .civic-dash-rotate,\n  .civic-dash-rotate-reverse {\n    animation: none !important;\n  }\n}\n","StartLine":488,"TargetContent":"/* Print Styles */\n@media print {\n  body {\n    background: #ffffff !important;\n    color: #000000 !important;\n  }\n  header, footer, nav, .btn-tool, .btn-primary-action, .filter-bar {\n    display: none !important;\n  }\n}","TargetFile":"C:\\Users\\JAHID\\.gemini\\antigravity\\scratch\\NagrikOne\\app\\globals.css","toolAction":"Adding animation styles","toolSummary":"Auth and animation CSS"}}]}
